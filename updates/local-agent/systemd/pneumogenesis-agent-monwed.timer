[Unit]
Description=Pneumogenesis updates agent — Monday and Wednesday 08:52 Athens

[Timer]
OnCalendar=Mon,Wed *-*-* 08:52:00 Europe/Athens
# If the computer was off or asleep at that time, run as soon as it is back.
Persistent=true
Unit=pneumogenesis-agent@monwed.service

[Install]
WantedBy=timers.target
